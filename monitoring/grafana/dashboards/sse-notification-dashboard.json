{
  "title": "SSE Notification Service",
  "uid": "sse-notification",
  "timezone": "Asia/Seoul",
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "title": "SSE Active Connections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sse_connections_active", "legendFormat": "active" }
      ]
    },
    {
      "title": "SSE Subscribe Rate (/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "rate(sse_subscribe_total[1m])", "legendFormat": "subscribe/s" }
      ]
    },
    {
      "title": "SSE Send Rate (/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "rate(sse_send_total{result=\"success\"}[1m])", "legendFormat": "success/s" },
        { "expr": "rate(sse_send_total{result=\"fail\"}[1m])", "legendFormat": "fail/s" }
      ]
    },
    {
      "title": "SSE Timeout & Reconnect Rate (/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "rate(sse_timeout_total[1m])", "legendFormat": "timeout/s" },
        { "expr": "rate(sse_reconnect_total[1m])", "legendFormat": "reconnect/s" }
      ]
    },
    {
      "title": "HTTP Request Duration",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "http_server_requests_seconds_max", "legendFormat": "max {{uri}}" },
        { "expr": "rate(http_server_requests_seconds_sum[1m]) / rate(http_server_requests_seconds_count[1m])", "legendFormat": "avg {{uri}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "HTTP Request Rate (/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count[1m])) by (uri, status)", "legendFormat": "{{uri}} {{status}}" }
      ]
    },
    {
      "title": "Executor Threads (Tomcat)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        { "expr": "executor_pool_size_threads", "legendFormat": "pool size" },
        { "expr": "executor_active_threads", "legendFormat": "active" },
        { "expr": "executor_pool_max_threads", "legendFormat": "max" },
        { "expr": "executor_pool_core_threads", "legendFormat": "core" }
      ]
    },
    {
      "title": "HikariCP Connections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        { "expr": "hikaricp_connections_active", "legendFormat": "active" },
        { "expr": "hikaricp_connections_idle", "legendFormat": "idle" },
        { "expr": "hikaricp_connections_pending", "legendFormat": "pending" },
        { "expr": "hikaricp_connections_max", "legendFormat": "max" }
      ]
    },
    {
      "title": "JVM Heap Memory",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "targets": [
        { "expr": "jvm_memory_used_bytes{area=\"heap\"}", "legendFormat": "used {{id}}" },
        { "expr": "jvm_memory_committed_bytes{area=\"heap\"}", "legendFormat": "committed {{id}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "title": "JVM GC Pause",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "targets": [
        { "expr": "rate(jvm_gc_pause_seconds_sum[1m])", "legendFormat": "pause time/s" },
        { "expr": "rate(jvm_gc_pause_seconds_count[1m])", "legendFormat": "pause count/s" }
      ]
    },
    {
      "title": "Process Open File Descriptors",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "targets": [
        { "expr": "process_files_open_files", "legendFormat": "open" },
        { "expr": "process_files_max_files", "legendFormat": "max" }
      ]
    },
    {
      "title": "CPU Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "targets": [
        { "expr": "process_cpu_usage", "legendFormat": "process" },
        { "expr": "system_cpu_usage", "legendFormat": "system" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    }
  ]
}
